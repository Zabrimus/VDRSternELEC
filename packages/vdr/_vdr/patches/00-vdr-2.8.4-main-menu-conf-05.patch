+static bool PluginInMenu(const cList<cNestedItem> *Items, const char *Name)
+{
+  for (const cNestedItem *Item = Items->First(); Item; Item = Items->Next(Item)) {
+      if (Item->SubItems() && PluginInMenu(Item->SubItems(), Name))
+         return true;
+      if (const char *s = Item->Text()) {
+         if (*s == '@') {
+            s++;
+            const char *p = strchr(s, ':');
+            size_t l = p ? p - s : strlen(s);
+            if (strncmp(s, Name, l) == 0 && strlen(Name) == l)
+               return true;
+            }
+         }
+      }
+  return false;
+}
