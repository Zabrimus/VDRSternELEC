diff --git a/packages/addons/addon-depends/tntnet/package.mk b/packages/addons/addon-depends/tntnet/package.mk
index 227fbf0261..4c7956ddcf 100644
--- a/packages/addons/addon-depends/tntnet/package.mk
+++ b/packages/addons/addon-depends/tntnet/package.mk
@@ -9,7 +9,7 @@ PKG_LICENSE="LGPL-2.1-or-later"
 PKG_SITE="https://github.com/maekitalo/tntnet"
 PKG_URL="${PKG_SITE}/archive/${PKG_VERSION}.tar.gz"
 PKG_DEPENDS_HOST="cxxtools:host zlib:host"
-PKG_DEPENDS_TARGET="toolchain tntnet:host libtool cxxtools zlib"
+PKG_DEPENDS_TARGET="toolchain tntnet:host libtool cxxtools zlib openssl"
 PKG_LONGDESC="A web application server for C++."
 PKG_TOOLCHAIN="autotools"
 
@@ -24,6 +24,10 @@ PKG_CONFIGURE_OPTS_TARGET="--disable-unittest \
                            --disable-sdk \
                            --disable-demos"
 
+pre_configure_target() {
+  export LDFLAGS="-lcrypto -lssl ${LDFLAGS}"
+}
+
 post_configure_target() {
   libtool_remove_rpath libtool
 }
